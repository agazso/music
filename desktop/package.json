{
  "name": "music-desktop",
  "productName": "Music",
  "version": "0.3.0",
  "private": true,
  "description": "Navidrome and the music frontend packaged as one desktop app",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "navidrome": "node scripts/fetch-navidrome.mjs",
    "build:frontend": "cd ../frontend && pnpm build --outDir ../desktop/dist --emptyOutDir",
    "dev": "electron .",
    "dist": "pnpm navidrome && pnpm build:frontend && electron-builder --linux --publish never",
    "dist:mac": "pnpm navidrome && pnpm build:frontend && electron-builder --mac --arm64 --publish never",
    "pack:mac:dir": "electron-builder --mac --arm64 --dir --publish never",
    "pack:mac": "electron-builder --mac dmg zip --arm64 --prepackaged release/mac-arm64/Music.app --publish never"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.musicapp.desktop",
    "asar": false,
    "files": [
      "main.js",
      "preload.cjs",
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "bin/navidrome",
        "to": "navidrome"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png",
      "maintainer": "Attila Gazso <agazso@gmail.com>"
    },
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.music",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "darkModeSupport": true
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "homepage": "https://github.com/agazso/music",
  "author": "Attila Gazso <agazso@gmail.com>"
}
